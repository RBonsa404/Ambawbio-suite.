{
  "realm": "ambawbio",
  "displayName": "Ambawbio Suite",
  "enabled": true,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr",
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(10) and notUsername and notEmail",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "ne-pas-repondre@demo.ambawbio.bf",
    "fromDisplayName": "Ambawbio Suite"
  },
  "roles": {
    "realm": [
      {
        "name": "caissier",
        "description": "Caissier ou caissière : vente au comptoir"
      },
      {
        "name": "gerant",
        "description": "Gérant : supervision, validation des écarts"
      },
      {
        "name": "magasinier",
        "description": "Magasinier : réceptions, transferts, inventaires"
      },
      {
        "name": "commercial",
        "description": "Commercial : devis et clients"
      },
      {
        "name": "comptable",
        "description": "Comptable : écritures et états financiers (MFA obligatoire)",
        "composite": true,
        "composites": {
          "realm": [
            "mfa-obligatoire"
          ]
        }
      },
      {
        "name": "administrateur",
        "description": "Administrateur de l'entreprise (MFA obligatoire)",
        "composite": true,
        "composites": {
          "realm": [
            "mfa-obligatoire"
          ]
        }
      },
      {
        "name": "dirigeant",
        "description": "Dirigeant (MFA obligatoire)",
        "composite": true,
        "composites": {
          "realm": [
            "mfa-obligatoire"
          ]
        }
      },
      {
        "name": "admin-plateforme",
        "description": "Éditeur : console de la plateforme (MFA recommandée)"
      },
      {
        "name": "mfa-obligatoire",
        "description": "Technique : impose la double authentification (composé dans comptable, administrateur, dirigeant)"
      }
    ]
  },
  "browserFlow": "navigateur ambawbio",
  "authenticationFlows": [
    {
      "alias": "navigateur ambawbio",
      "description": "Mot de passe, puis code à usage unique pour les rôles sensibles (guide §6.5)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "formulaires ambawbio"
        }
      ]
    },
    {
      "alias": "formulaires ambawbio",
      "description": "Identifiant et mot de passe, MFA conditionnelle",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "mfa selon role"
        }
      ]
    },
    {
      "alias": "mfa selon role",
      "description": "OTP exigé si l'utilisateur a le rôle mfa-obligatoire",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-role",
          "authenticatorFlow": false,
          "authenticatorConfig": "role mfa-obligatoire"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "role mfa-obligatoire",
      "config": {
        "condUserRole": "mfa-obligatoire",
        "negate": "false"
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ADMIN_VIEW\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"tenant_id\", \"displayName\": \"Entreprise (tenant)\", \"validations\": {\"pattern\": {\"pattern\": \"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$\", \"error-message\": \"UUID attendu\"}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "ambawbio-web",
      "name": "Ambawbio Suite (web et Android)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "https://localhost/*",
        "http://localhost/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "https://localhost",
        "http://localhost"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##https://localhost/*##http://localhost/*"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ambawbio-serveur",
      "name": "Serveur Ambawbio (compte de service)",
      "enabled": true,
      "publicClient": false,
      "secret": "ambawbio-serveur-dev",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
